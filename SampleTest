
import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.MethodSource;

public class SwiftFileServiceTest {

    private static final int UNKNOWN_PLAN_ID = -8;

    private final SwiftFileService service = new SwiftFileService();

    public static Object[][] fundNumberData() {
        // @formatter:off
        return new Object[][] {

        // @formatter:on
    }

    public static Object[][] payrollAppropriationIdData() {
        // @formatter:off
        return new Object[][] {

        // @formatter:on
    }

    public static Object[][] planIdsWithoutFundNumber() {
        // @formatter:off
        return new Object[][] {
            { UNKNOWN_PLAN_ID },
            { (int) PlanCode.JCCS.getCode() }
        };
        // @formatter:on
    }

    public static Object[][] planIdsWithoutPayrollAppropriationId() {
        // @formatter:off
        return new Object[][] {
            { UNKNOWN_PLAN_ID },
            { (int) PlanCode.JCCS.getCode() },
            { (int) PlanCode.DCP.getCode() },
            { (int) PlanCode.HCSP.getCode() },
            { (int) PlanCode.SRHC.getCode() }
        };
        // @formatter:on
    }

    @ParameterizedTest(name = "[{index}] {0} -> {1}")
    @MethodSource("fundNumberData")
    public void testGetFundNumber(final PlanCode plan, final int expectedFundNumber) {
        assertThat(service.getFundNumber(plan.getCode())).isEqualTo(expectedFundNumber);
    }

    @ParameterizedTest(name = "[{index}] planId={0}")
    @MethodSource("planIdsWithoutFundNumber")
    public void testGetFundNumberThrowsIllegalArgumentException(final int planId) {
        assertThatThrownBy(() -> service.getFundNumber(planId))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessage("No fund number found for this plan id");
    }

    @Test
    public void testGetPayrollAccountNumber() {
        assertThat(service.getPayrollAccountNumber()).isEqualTo(557112);
    }

    @ParameterizedTest(name = "[{index}] {0} -> {1}")
    @MethodSource("payrollAppropriationIdData")
    public void testGetPayrollAppropriationId(final PlanCode plan, final String expectedAppropriationId) {
        assertThat(service.getPayrollAppropriationId(plan.getCode())).isEqualTo(expectedAppropriationId);
    }

    @ParameterizedTest(name = "[{index}] planId={0}")
    @MethodSource("planIdsWithoutPayrollAppropriationId")
    public void testGetPayrollAppropriationIdThrowsIllegalArgumentException(final int planId) {
        assertThatThrownBy(() -> service.getPayrollAppropriationId(planId))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessage("No appropriation id found for plan number " + planId + ".");
    }
}
